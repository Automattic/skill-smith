# Copy this file to .env and fill in the keys for the providers you use.
# Skillsmith loads .env from the directory you invoke it from.
# Shell env vars take precedence over .env.

# Required for provider "anthropic-api"
# Note: the "claude-code" provider does NOT use this key. It authenticates via
# your Claude Code subscription (interactive `/login`, or the
# CLAUDE_CODE_OAUTH_TOKEN token for headless/CI). ANTHROPIC_API_KEY and
# ANTHROPIC_AUTH_TOKEN are excluded from "claude-code" so it never bills the
# pay-as-you-go API account; they still power "anthropic-api" as usual.
ANTHROPIC_API_KEY=

# Required for provider "openai-api" (also used by the codex CLI)
OPENAI_API_KEY=

# Required for provider "gemini-api"
# Note: this is the canonical name @ai-sdk/google expects.
GOOGLE_GENERATIVE_AI_API_KEY=
